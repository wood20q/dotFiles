@define-color text #ffffff;
@define-color background #111111;

* {
  border: none;
  font-family: "JetbrainsMono Nerd Font Mono";
  font-size: 15px;
  min-height: 10px;
  color: @text;
}

window#waybar {
  background: rgba(34, 36, 54, 0.0);
}

window#waybar.hidden {
  opacity: 0.2;
}

#network,
#bluetooth {
  padding: 5px;
  margin: 5px;
  background: @background;
  border-radius: 5px;
}
